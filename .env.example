# Exemple de configuration pour docker compose à la racine du monorepo.
# Copier ce fichier vers .env et adapter les valeurs. Ne jamais committer .env.

# Mot de passe PostgreSQL. À remplacer impérativement en production.
FASTSEARCH_DB_PASSWORD=fastsearch

# Données synthétiques de démonstration (196 personnes). Passer à false en production.
FASTSEARCH_DEMO_ENABLED=true

# Interface d'écoute publiée par Docker. 127.0.0.1 limite l'accès à la machine locale.
FASTSEARCH_BIND_ADDRESS=127.0.0.1
FASTSEARCH_BACKEND_PORT=8080
FASTSEARCH_HTTP_PORT=8081

# Options JVM du backend.
JAVA_OPTS=-XX:MaxRAMPercentage=75
